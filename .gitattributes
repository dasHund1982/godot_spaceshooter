# Zeilenenden normalisieren: im Repo immer LF, im Arbeitsverzeichnis nativ.
* text=auto eol=lf

# Godot-Textformate explizit
*.gd      text eol=lf
*.tscn    text eol=lf
*.tres    text eol=lf
*.godot   text eol=lf
*.cfg     text eol=lf
*.import  text eol=lf

# Binaerdateien: nie anfassen, nie diffen
*.png  binary
*.jpg  binary
*.webp binary
*.ogg  binary
*.wav  binary
*.mp3  binary
*.ttf  binary
*.otf  binary
